PORT=3000

# La API y DbGate usan una u otra según el comando:
#   make up        -> MONGODB_URI_LOCAL (Mongo en Docker)
#   make up-atlas  -> MONGODB_URI_ATLAS
MONGODB_URI_LOCAL=mongodb://mongo:27017/ordenalink?replicaSet=rs0&directConnection=true
MONGODB_URI_ATLAS=mongodb+srv://USER:PASS@HOST/ordenalink?retryWrites=true&w=majority

JWT_SECRET=cambia-esto
GOOGLE_CLIENT_ID=
